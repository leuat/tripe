program MyProgram;

@startassembler "

.code uint16:0x801 run

.uint8 0b  08 0a 00 9e 20 32  30 36 34  00  00  00  ff
"

@endassembler ""
var  
   i,j: byte; 
	p:^byte;
begin
	screen_bg_col:=black;
	p:=$0400;
	j:=0;
	for i:=0 to 40 do
	begin
		
		p[i*2]:=j;
		p[i*2+1]:=j;
		j+=2;
		if (i=3) then
		begin
			screen_bg_col:=white;
		end;
	end;
	

	asm(" 
	
.label eee
	jump eee

");
end.
