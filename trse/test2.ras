program HelloWorld;
@use "screen/screen"
@use "system/memory"
@startassembler "

.code uint16:0x801 run

.uint8 0b  08 0a 00 9e 20 32  30 36 34  00  00  00  ff
"


//@use "system/memory"
var  
	// you can split strings into several substrings	
	
  	text : string = ("HELLO  WORLD");
	cheap_scroller : string = "YES THIS IS A VERY STRING AND IT WILL NOT LOOK PARTICULARLY NICE WHEN IT REACHES ITS END BECAUSE THERE IS NO TEST WHETHER THE STRING SHOULD WRAP OR NOT";
	i, j:byte;
	k:byte = 4;
	p,t,sp : ^byte;
	tab :array[25] of integer = buildtable("i*40");
	time : byte = 0;
//	screenmemory: ^byte;
	@donotremove screenmemory





procedure Tst();
begin
	k:=t[j+time];	
	p[j] := k;
	
end;
	
begin
		
	Screen::PrintString(#text, 1,16*2,#Screen::Screen0);

	time := time+220;
	screen_bg_col:=black;
	// Fill the screen (at screen0 = $400) with  40*25 bytes of character $20 - "space"
	Screen::Clear(#Screen::screen0, key_space);
	
	// Fill the color ram with yellow
	Screen::Clear(#Screen::color, yellow);
	// Print a string at 10, 12 	
	Screen::PrintString(#text, 10,12,#Screen::Screen0);
	// Print another string directly
//	Screen::PrintString(cstring("THIS IS ANOTHER STRING 123"), 10,14,#Screen::Screen0);
	// Infinite loop
		t:=#cheap_scroller;
	
	while (true) do
	begin
		// Wait a bit
		i+=1;
		screen_bg_col:=i;
		for j:=0 to 4 do
			Screen::WaitForVerticalBlank();
			
		// Point ptr to line 22 on the screen
		p := #Screen::screen0 + (screen_width*22);	
		// Copy the data from the cstring to the screen
		asm(";fail");
		t:=#cheap_scroller+time;
		Memory::Copy(t, p, 40);
		
		Tst();
		
		// Increase the counter
		// Reset the text counter when the reaches the end of the string
		if (i=length(cheap_scroller)-40) then i:=0;
		time+=1;
	end;	


	

end.